# Copie para .deploy.env (que fica fora do git) e preencha.

# ----- GitHub Pages -----
GIT_REMOTE=origin
GIT_BRANCH=main
GITHUB_PAGES_URL=https://nataferreiradev.github.io/portfolio/

# ----- Hostinger -----
# ssh (recomendado; planos Premium/Business+) ou ftp
HOSTINGER_METHOD=ssh

# hPanel → Avançado → Acesso SSH (ou Contas FTP, se usar ftp)
HOSTINGER_HOST=123.45.67.89
HOSTINGER_USER=u123456789
# SSH na Hostinger usa a porta 65002; FTP usa 21. Deixe vazio para o padrão.
HOSTINGER_PORT=
# Chave SSH opcional (adicione a pública em hPanel → Acesso SSH → Chaves SSH)
HOSTINGER_SSH_KEY=~/.ssh/id_ed25519
# Só para ftp:
HOSTINGER_PASSWORD=

# Pasta pública do domínio
#   via SSH: domains/seudominio.com/public_html   (relativo à home)
#   via FTP: /public_html  (se a conta FTP já aponta para o domínio)
HOSTINGER_PATH=domains/seudominio.com/public_html
HOSTINGER_URL=https://seudominio.com

# 1 = espelha exatamente (apaga no servidor arquivos removidos aqui); 0 = só envia/atualiza
HOSTINGER_DELETE=1
